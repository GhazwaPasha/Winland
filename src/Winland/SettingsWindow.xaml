<Window x:Class="Winland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winland Settings"
        Width="400"
        Height="320"
        MinWidth="360"
        MinHeight="280"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="{StaticResource NotchFontFamily}">

    <!--
        Background is intentionally NOT set to the notch's own NotchPanelBrush
        (or any other opaque brush) — DwmInterop.ApplyMicaBackdrop (called
        from code-behind once the hwnd exists) paints the real Mica surface
        straight onto this window's native client area, and anything WPF
        itself draws behind the content would just paper over that. This is
        the one window in the app that keeps its native title bar/border
        (see MainWindow's class doc for why *that* window has none) — Mica
        needs a real DWM-composed, non-layered window (AllowsTransparency
        left at its default False here), which a borderless overlay like the
        notch specifically can't be.

        ResizeMode is CanResize (not NoResize) specifically so the title bar
        shows the normal minimize/maximize/close trio, matching what a real
        Windows 11 app window looks like, rather than reading as a fixed
        little dialog with only a close button. Width/Height are a plain
        starting size rather than SizeToContent — SizeToContent fights a
        user's own resize the moment they drag an edge.
    -->
    <Window.Resources>
        <!--
            A Windows-11-style pill toggle — WPF ships no ToggleSwitch
            control, so this re-templates a plain ToggleButton: a rounded
            track (accent-filled when on, the same NotchSliderTrackBrush the
            Vitals rings' background arc and media progress track already
            use when off) plus a thumb that slides via TranslateTransform.
            2px inset on both sides (thumb X=2 off / X=18 on, for a 36-wide
            track and 16-wide thumb) is what the 16-unit slide distance below
            is measured against.
        -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track" CornerRadius="10"
                                    Background="{StaticResource NotchSliderTrackBrush}" />
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource NotchAccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="16" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row's layout (icon chip, title + description, toggle), reused
             for each setting below rather than an ItemsControl/DataTemplate
             — only two rows exist today, and the app's other tabs (Media,
             Network) already favor plain repeated XAML over data-templating
             for a handful of fixed rows. -->
        <Style x:Key="SettingRowIconStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource NotchTileBrush}" />
        </Style>

        <!-- Plain single-line text entry, themed to match the rest of this
             window — WPF's stock TextBox otherwise renders with a white
             system background/border that would look like a stray hole in
             the Mica surface. No placeholder text (TextBox has no native
             support for one) — the row's own description label above it
             carries that instead. -->
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource NotchSliderTrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NotchTextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource NotchTextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource NotchTextPrimaryBrush}" Margin="0,0,0,16" />

        <Border Background="{StaticResource NotchTabBarBackgroundBrush}" CornerRadius="10" Padding="4">
            <StackPanel>

                <!-- Start at startup -->
                <Grid Margin="8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingRowIconStyle}">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource NotchTextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="Start at startup" FontSize="13"
                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                        <TextBlock Text="Launch Winland automatically when you sign in" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                    </StackPanel>

                    <ToggleButton Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding StartAtStartup}" />
                </Grid>

                <Border Height="1" Margin="8,2" Background="{StaticResource NotchStrokeBrush}" />

                <!-- Start minimized to tray -->
                <Grid Margin="8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingRowIconStyle}">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource NotchTextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="Start minimized" FontSize="13"
                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                        <TextBlock Text="Keep the notch hidden in the tray on launch" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                    </StackPanel>

                    <ToggleButton Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding StartMinimized}" />
                </Grid>

                <Border Height="1" Margin="8,2" Background="{StaticResource NotchStrokeBrush}" />

                <!-- Black mode -->
                <Grid Margin="8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- A plain filled circle rather than a Segoe glyph — this
                         row is literally about a solid-black fill, so the
                         icon can just show that directly instead of standing
                         in for it with an unrelated pictogram. -->
                    <Border Grid.Column="0" Style="{StaticResource SettingRowIconStyle}">
                        <Ellipse Width="16" Height="16" Fill="Black"
                                 Stroke="{StaticResource NotchStrokeBrush}" StrokeThickness="1" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="Black mode" FontSize="13"
                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                        <TextBlock Text="Make the notch background solid black" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                    </StackPanel>

                    <ToggleButton Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding BlackMode}" />
                </Grid>

                <!-- The Weather API key row (OpenWeatherMap override) lived here —
                     removed along with the rest of the module ahead of the Store
                     submission; see STORE_SUBMISSION.md's "Weather module —
                     detached, not deleted" section. -->

            </StackPanel>
        </Border>
    </StackPanel>
</Window>
