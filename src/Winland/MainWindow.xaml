<Window x:Class="Winland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Winland.Converters"
        Title="Winland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:DoubleToDashArrayConverter x:Key="DoubleToDashArray" />

        <!-- Shared by the cam/mic status dots (collapsed + expanded, 4 total) — a
             slow breathing fade rather than a static dot, so an active indicator
             reads as "live" at a glance instead of looking like a painted-on icon.
             Starts on Loaded rather than on Visibility becoming true: these dots
             use Visibility="Collapsed" (not removed from the tree), so Loaded
             fires once at window startup and the animation just runs continuously
             underneath, invisible whenever the dot itself is collapsed. -->
        <Style x:Key="PulsingDotStyle" TargetType="Ellipse">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1.0" To="0.35" Duration="0:0:1.8"
                                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same breathing-fade idea as PulsingDotStyle above, generalized to
             FrameworkElement (rather than Ellipse-only) so the Shelf tab's
             loading placeholder — a plain glyph, not a dot — can use it too.
             The Shelf's icon lookup is Shell/COM interop (see
             ShellThumbnailProvider) and can take a real moment for a video or
             a networked path; without this, a just-dropped chip either
             blocked the drop until it resolved or, once that was made async,
             sat there with a blank icon slot and nothing to suggest anything
             was happening. -->
        <Style x:Key="PulsingOpacityStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.9" To="0.3" Duration="0:0:0.9"
                                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell"
          Background="Transparent"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          MouseLeftButtonUp="Shell_MouseLeftButtonUp"
          AllowDrop="True"
          DragEnter="Shell_DragEnter"
          DragOver="Shell_DragOver"
          Drop="Shell_Drop">

        <!-- The notch silhouette: a plain rounded-bottom rectangle can't
             show the Dynamic-Island-style flare at the top corners (it
             curves outward past the wall, then back in — a Border's
             single-radius CornerRadius only ever curves one way and never
             outside its own rect), so the shape is a hand-built Path
             instead. Fill and stroke are split into two Paths because the
             stroke deliberately omits the flat top edge (this used to be
             BorderThickness="1,0,1,1" — no top edge) while the fill needs
             the full closed outline. Both Data values are rebuilt in
             code-behind (see BuildShellGeometry) any time Shell resizes,
             including every frame of the expand/collapse animation. -->
        <Path x:Name="ShellFillPath" Fill="{DynamicResource NotchPanelBrush}" IsHitTestVisible="False" />
        <Path x:Name="ShellStrokePath" Stroke="{DynamicResource NotchStrokeBrush}" StrokeThickness="1" IsHitTestVisible="False" />

        <!-- Clipped to the same geometry as ShellFillPath, kept in sync
             every frame in UpdateShellGeometry — a plain Grid doesn't
             auto-clip its children the way Border used to whenever
             CornerRadius was set, so without this the content renders at
             its full, un-clipped size mid-animation: it visibly outgrows
             the still-catching-up background shape, reading as a stale
             ghost of the old (collapsed or expanded) silhouette left
             behind the new one. -->
        <Grid x:Name="ShellContent">

            <!-- ==================== Collapsed pill ==================== -->
            <StackPanel x:Name="CollapsedPanel"
                        Orientation="Horizontal"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCollapsedIconRowVisible, Converter={StaticResource BoolToVis}}">

                <!-- Identity block: the clock always anchors the left edge, in both
                     the collapsed pill and the expanded header below. The status
                     block that follows keeps the exact same element order in both
                     states too (cam/mic -> headphone -> pin), so expanding reads
                     as one object reshaping instead of elements swapping sides. -->
                <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource NotchTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                         Style="{StaticResource PulsingDotStyle}"
                         Fill="{StaticResource NotchCamActiveBrush}"
                         Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}" />
                <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                         Style="{StaticResource PulsingDotStyle}"
                         Fill="{StaticResource NotchWarningBrush}"
                         Visibility="{Binding IsMicInUse, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding IsHeadphoneConnected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{StaticResource NotchTextPrimaryBrush}"
                               Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource InverseBoolToVis}}" />
                    <Path Data="{StaticResource SurfaceEarbudsGeometry}" Stretch="Uniform" Width="14" Height="14"
                          Fill="{StaticResource NotchTextPrimaryBrush}"
                          Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding HeadphoneBatteryPercent, StringFormat={}{0}%}" FontSize="10" Margin="3,0,0,0"
                               Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center"
                               Visibility="{Binding HasHeadphoneBattery, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Only rendered while pinned — like the cam/mic dots above, this
                     is a "notable state" indicator, not a permanent status readout.
                     Unpinning always happens via the same lock chip in the expanded
                     header; clicking this one (while it's visible) still unpins
                     directly, same as the old pin icon did. -->
                <!-- Same footprint (20x20, radius 4) and icon size (12) as the
                     expanded header's pin chip below — this is the same
                     control in two states, so it shouldn't visibly resize
                     between them. -->
                <Grid Margin="0,0,8,0" VerticalAlignment="Center"
                      MouseLeftButtonUp="PinIcon_MouseLeftButtonUp"
                      Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                    <Border Width="20" Height="20" CornerRadius="4"
                            Background="{StaticResource NotchTabBarBackgroundBrush}" />
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource NotchAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- ==================== Collapsed "now playing" pill ====================
                 Swapped in for CollapsedPanel while media is actively playing: album art
                 pinned to one edge, an animated waveform to the other — same idea as a
                 Dynamic Island reacting to audio. -->
            <Grid x:Name="CollapsedMediaPanel"
                  Margin="16,0,16,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsCollapsedMediaVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                        Background="{StaticResource NotchTileBrush}" ClipToBounds="True">
                    <!-- Border.CornerRadius only rounds the Border's own background, not
                         child content, so the Image needs its own clip geometry too. -->
                    <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                        </Image.Clip>
                    </Image>
                </Border>

                <!-- Bar heights are driven from code-behind (StartWaveformAnimation) rather
                     than a Style trigger here: Storyboard.TargetName can't target a sibling
                     element from inside a plain Style/DataTrigger — only from a
                     ControlTemplate/DataTemplate — so a shared Style.Triggers block can't
                     reach these named Rectangles. -->
                <StackPanel x:Name="WaveformBars" Grid.Column="2" Orientation="Horizontal"
                            Height="16" VerticalAlignment="Center">
                    <Rectangle x:Name="WaveBar1" Width="3" Height="5" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                    <Rectangle x:Name="WaveBar2" Width="3" Height="14" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                    <Rectangle x:Name="WaveBar3" Width="3" Height="9" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                    <Rectangle x:Name="WaveBar4" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- ==================== Expanded flyout ==================== -->
            <Grid x:Name="ExpandedPanel"
                  Margin="18,16,18,18"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TimeText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                        <TextBlock Text="{Binding DateText}" FontSize="12" Margin="8,0,0,3"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Style="{StaticResource PulsingDotStyle}"
                                 Fill="{StaticResource NotchCamActiveBrush}"
                                 Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}" />
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Style="{StaticResource PulsingDotStyle}"
                                 Fill="{StaticResource NotchWarningBrush}"
                                 Visibility="{Binding IsMicInUse, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding IsHeadphoneConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}"
                                       Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource InverseBoolToVis}}" />
                            <Path Data="{StaticResource SurfaceEarbudsGeometry}" Stretch="Uniform" Width="14" Height="14"
                                  Fill="{StaticResource NotchTextSecondaryBrush}"
                                  Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding HeadphoneBatteryPercent, StringFormat={}{0}%}" FontSize="10" Margin="3,0,0,0"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center" Opacity="0.85"
                                       Visibility="{Binding HasHeadphoneBattery, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Always visible here (unlike the collapsed one) — this is the
                             one place both pinned and unpinned states, and the actual
                             toggle, live. -->
                        <!-- Same footprint (20x20, radius 4) and icon size (12) as the
                             collapsed pill's pin chip — see the note there. -->
                        <Grid Margin="0,0,8,0" VerticalAlignment="Center"
                              MouseLeftButtonUp="PinIcon_MouseLeftButtonUp">
                            <Border Width="20" Height="20" CornerRadius="4"
                                    Background="{StaticResource NotchTabBarBackgroundBrush}" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE785;" />
                                        <Setter Property="Foreground" Value="{StaticResource NotchTextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="&#xE72E;" />
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Tab bar -->
                <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource NotchTabBarBackgroundBrush}" CornerRadius="8" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Background="Transparent" MouseLeftButtonUp="MediaTab_MouseLeftButtonUp">
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="Media">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonUp="AiTab_MouseLeftButtonUp">
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAiTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="AI">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAiTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="2" Background="Transparent" MouseLeftButtonUp="VitalsTab_MouseLeftButtonUp">
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVitalsTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="Vitals">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVitalsTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="3" Background="Transparent" MouseLeftButtonUp="ShelfTab_MouseLeftButtonUp">
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="Shelf">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tab content -->
                <Grid Grid.Row="2" Margin="0,14,0,0">

                    <!-- Media tab -->
                    <!-- VerticalAlignment="Center" rather than the Grid row's default
                         top-align: this tab's content (64px thumbnail + a few text
                         lines) is far shorter than the shared content row's height (see
                         NotchHeight's doc comment for why every tab shares one height),
                         so top-aligning it left a large dead gap below; centering
                         balances that leftover space above and below instead. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsMediaTabSelected, Converter={StaticResource BoolToVis}}">
                        <Grid Width="64" Height="64" Margin="0,0,12,0">
                            <Border CornerRadius="8" Background="{StaticResource NotchTileBrush}" />
                            <!-- Idle placeholder — reuses the Media tab's own glyph, so an
                                 empty tile reads as "no track loaded" at a glance instead of
                                 as a blank, unfinished-looking square. -->
                            <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasActiveMediaSession, Converter={StaticResource InverseBoolToVis}}" />
                            <!-- Border.CornerRadius only rounds the Border's own background, not
                                 child content, so the Image needs its own clip geometry too. -->
                            <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding HasActiveMediaSession, Converter={StaticResource BoolToVis}}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8" />
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <StackPanel Width="288" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource NotchTextPrimaryBrush}" />
                            <TextBlock Text="{Binding MediaArtist}" FontSize="11" Margin="0,2,0,10"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource NotchTextSecondaryBrush}" />

                            <ProgressBar Value="{Binding MediaProgress}" Minimum="0" Maximum="1"
                                         Height="3" Margin="0,0,0,10"
                                         Foreground="{DynamicResource NotchAccentBrush}"
                                         Background="{StaticResource NotchSliderTrackBrush}" BorderThickness="0" />

                            <!-- Dimmed and click-through while nothing is loaded, so the
                                 transport row reads as idle rather than as active controls
                                 that just happen to do nothing when pressed. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveMediaSession}" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Width="24" Height="24" Background="Transparent" Margin="0,0,16,0" MouseLeftButtonUp="Previous_MouseLeftButtonUp">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>

                                <Grid Width="30" Height="30" Margin="0,0,16,0" Background="Transparent" MouseLeftButtonUp="PlayPause_MouseLeftButtonUp">
                                    <Ellipse Fill="{DynamicResource NotchAccentBrush}" />
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource NotchOnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE768;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                        <Setter Property="Text" Value="&#xE769;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Width="24" Height="24" Background="Transparent" MouseLeftButtonUp="Next_MouseLeftButtonUp">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- AI tab -->
                    <!-- Centered for the same reason as the Media tab above — this
                         content is shorter than the shared content row. -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsAiTabSelected, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Circular, matching the ring/dot vocabulary the rest of
                                 this tab already uses (the usage rings, the pulsing
                                 status dot below) — a rounded-square badge was the one
                                 shape in the tab that didn't belong to that family. The
                                 real Claude mark (ClaudeMarkGeometry, see App.xaml) drawn
                                 white on top, replacing what used to be a plain "C". -->
                            <Ellipse Grid.Column="0" Width="28" Height="28" Fill="{StaticResource NotchClaudeBrush}" />
                            <Path Grid.Column="0" Data="{StaticResource ClaudeMarkGeometry}" Stretch="Uniform"
                                  Width="15" Height="15" Fill="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                            <TextBlock Grid.Column="1" Text="Claude" FontSize="13" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" />

                            <!-- Reflects real Claude Code activity now (see
                                 ClaudeCodeActivityService) instead of an always-true
                                 "Working…" that never meant anything — the dot pulses
                                 exactly when at least one session is actually open. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,5,0"
                                         Fill="{DynamicResource NotchAccentBrush}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveClaudeSessions}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseBeginStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1" To="0.5" Duration="0:0:1.4"
                                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseBeginStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SessionStatusText}" FontSize="10"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Active Claude Code sessions — replaces the old Weekly/5-hour
                             usage rings entirely. Those depended on an unofficial Claude
                             Desktop cache file that repeatedly failed to read for reasons
                             that were never fully pinned down; this is backed by
                             ClaudeCodeActivityService instead, a plain process registry
                             (~/.claude/sessions/*.json cross-checked against actually-
                             running PIDs) with no inferred file-format guessing involved.
                             Flat rows — "Project - Session", project bold — rather than a
                             group header with an indented list underneath: every row names
                             its own project, so several projects' sessions sit in the same
                             list with nothing extra wrapping them. -->

                        <!-- Empty state — mirrors the Media tab's "Nothing playing" and the
                             Shelf tab's "Drag files onto the notch" rather than leaving a
                             blank area with no explanation. -->
                        <TextBlock Text="No active sessions" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}"
                                   Visibility="{Binding HasActiveClaudeSessions, Converter={StaticResource InverseBoolToVis}}" />

                        <!-- No explicit MaxHeight, same reasoning as the Shelf tab's
                             ScrollViewer above: MainWindow's MeasureAiTabHeight already
                             grows the notch to fit the real content height (up to
                             NotchViewModel.MaxAiTabHeight), so this only actually starts
                             scrolling once that ceiling is hit — a plain ScrollViewer
                             scrolls the moment it's arranged with less room than its
                             content wants, no MaxHeight required to make that happen. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasActiveClaudeSessions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding SessionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A real 4-column grid rather than a text+badge StackPanel
                                             stuffed into one "*" column — the label can run long
                                             enough (a real conversation title, see
                                             ClaudeCodeActivityService's custom-title lookup) to need
                                             TextTrimming, and a StackPanel doesn't clip its children
                                             just because its own box is constrained, so a long label
                                             would have pushed the badge/duration off rather than
                                             eliding itself. -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Doubles as the row's marker. Idle is a hollow ring —
                                                 outline only, no fill — and Active is the solid,
                                                 accent-colored, breathing-fade dot the cam/mic/
                                                 Claude-header dots already use elsewhere in this
                                                 app, just re-keyed to this row's own IsActive:
                                                 solid+pulsing reads as "something live is happening"
                                                 here exactly like it does there, and hollow reads as
                                                 "present but quiet" rather than just a dimmer copy of
                                                 the same solid dot. -->
                                            <Ellipse Grid.Column="0" Width="5" Height="5" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Transparent" />
                                                        <Setter Property="Stroke" Value="{StaticResource NotchTextSecondaryBrush}" />
                                                        <Setter Property="StrokeThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource NotchAccentBrush}" />
                                                                <Setter Property="StrokeThickness" Value="0" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SessionActivePulse">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1" To="0.5" Duration="0:0:1.4"
                                                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="SessionActivePulse" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- "Project - Session", project bold — Run.Text binds
                                                 fine in WPF (added in .NET 4.5+), so this stays one
                                                 TextBlock (one TextTrimming target) rather than two
                                                 separate elements that would need their own layout. -->
                                            <TextBlock Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource NotchTextPrimaryBrush}">
                                                <Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="Bold" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding SessionLabel, Mode=OneWay}" />
                                            </TextBlock>

                                            <!-- Only shown for a non-"interactive" kind (e.g. a
                                                 background task) — no badge at all is the common
                                                 case, so this only draws attention to the session
                                                 that's actually unusual. -->
                                            <Border Grid.Column="2" Margin="6,0,0,0" Padding="4,1" CornerRadius="4"
                                                    Background="{StaticResource NotchTabBarBackgroundBrush}"
                                                    Visibility="{Binding HasKindBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding KindBadge}" FontSize="9"
                                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="3" Margin="8,0,0,0" Text="{Binding DurationText}" FontSize="10"
                                                       Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Vitals tab -->
                    <!-- Centered for the same reason as the Media tab above — this
                         content is shorter than the shared content row. -->
                    <StackPanel VerticalAlignment="Center"
                                Visibility="{Binding IsVitalsTabSelected, Converter={StaticResource BoolToVis}}">
                        <!-- Sits above the rings row (rather than below it), Download then
                             Upload side by side as one compact centered row rather than
                             spread across the tab's full width. The icon badge and its
                             KB/s value sit side by side in one row. 22px badge is slightly
                             smaller than the 28px used elsewhere (AI tab avatar, shelf chip
                             icons) to leave room for the value beside it without widening
                             the row. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid Width="22" Height="22">
                                    <Ellipse Width="22" Height="22" Fill="{StaticResource NotchSliderTrackBrush}" />
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding NetworkDownKBs, StringFormat={}{0:0.0} KB/s}" FontSize="11" FontWeight="SemiBold"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource NotchTextPrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="22" Height="22">
                                    <Ellipse Width="22" Height="22" Fill="{StaticResource NotchSliderTrackBrush}" />
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding NetworkUpKBs, StringFormat={}{0:0.0} KB/s}" FontSize="11" FontWeight="SemiBold"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource NotchTextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Four equal-size live rings (CPU/Memory/Disk/GPU) instead of the
                             stacked bars this used to be — one bar row per metric didn't
                             scale cleanly to a fourth metric, and rings read as "live gauges"
                             at a glance the way the AI tab's usage ring already does, so this
                             also brings Vitals into the same visual language instead of being
                             the one tab still using flat bars. All four share one ring size
                             (VitalsRingRadius/VitalsRingCircumference in the view model) —
                             only each ring's DashOffset differs per metric. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44">
                                    <Ellipse Width="44" Height="44" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <Ellipse Width="44" Height="44" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding CpuDashOffset}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="CPU" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44">
                                    <Ellipse Width="44" Height="44" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <Ellipse Width="44" Height="44" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding RamDashOffset}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0}%}" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="Memory" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44">
                                    <Ellipse Width="44" Height="44" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <Ellipse Width="44" Height="44" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding DiskDashOffset}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DiskPercent, StringFormat={}{0:0}%}" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="Disk" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44">
                                    <Ellipse Width="44" Height="44" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <Ellipse Width="44" Height="44" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding GpuDashOffset}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding GpuPercent, StringFormat={}{0:0}%}" FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="GPU" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Shelf tab -->
                    <Grid Visibility="{Binding IsShelfTabSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drag files onto the notch" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}"
                                   Visibility="{Binding IsShelfEmpty, Converter={StaticResource BoolToVis}}" />

                        <!-- No explicit MaxHeight: this already sits in the tab content
                             Grid's "*" row, so it naturally stretches to whatever space
                             is actually left after the header/tab bar above it — a fixed
                             MaxHeight guess here could drift out of sync with that and
                             either clip early or overrun it. VerticalScrollBarVisibility
                             keeps handling the case where the shelf has more items than
                             fit. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsShelfEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ShelfItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="72" Height="76" Margin="0,0,10,10" CornerRadius="8"
                                                Background="{StaticResource NotchTileBrush}"
                                                PreviewMouseLeftButtonDown="ShelfChip_PreviewMouseLeftButtonDown"
                                                MouseMove="ShelfChip_MouseMove">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Pulsing placeholder glyph while the icon/thumbnail lookup is
                                                         still running (see ShelfItem.IsIconLoading) — swapped for the
                                                         real Image once it resolves, whatever it finds. -->
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                                               Width="28" Height="28" HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Foreground="{StaticResource NotchTextSecondaryBrush}"
                                                               Style="{StaticResource PulsingOpacityStyle}"
                                                               Visibility="{Binding IsIconLoading, Converter={StaticResource BoolToVis}}" />
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center"
                                                           Visibility="{Binding IsIconLoading, Converter={StaticResource InverseBoolToVis}}" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10" Margin="4,4,4,0" MaxWidth="64"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                           Foreground="{StaticResource NotchTextSecondaryBrush}"
                                                           MouseLeftButtonUp="RemoveShelfItem_MouseLeftButtonUp" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
