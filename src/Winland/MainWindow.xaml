<Window x:Class="Winland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Winland.Converters"
        Title="Winland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:DoubleToDashArrayConverter x:Key="DoubleToDashArray" />

        <!-- Shared by the cam/mic status dots (collapsed + expanded, 4 total) — a
             slow breathing fade rather than a static dot, so an active indicator
             reads as "live" at a glance instead of looking like a painted-on icon.
             Starts on Loaded rather than on Visibility becoming true: these dots
             use Visibility="Collapsed" (not removed from the tree), so Loaded
             fires once at window startup and the animation just runs continuously
             underneath, invisible whenever the dot itself is collapsed. -->
        <Style x:Key="PulsingDotStyle" TargetType="Ellipse">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1.0" To="0.35" Duration="0:0:1.8"
                                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same breathing-fade idea as PulsingDotStyle above, generalized to
             FrameworkElement (rather than Ellipse-only) so the Shelf tab's
             loading placeholder — a plain glyph, not a dot — can use it too.
             The Shelf's icon lookup is Shell/COM interop (see
             ShellThumbnailProvider) and can take a real moment for a video or
             a networked path; without this, a just-dropped chip either
             blocked the drop until it resolved or, once that was made async,
             sat there with a blank icon slot and nothing to suggest anything
             was happening. -->
        <Style x:Key="PulsingOpacityStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.9" To="0.3" Duration="0:0:0.9"
                                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Motion pass (see the notch design audit, §07) ============ -->

        <!-- Shared "press" feedback for every plain Grid/Border/TextBlock this
             file wires a MouseLeftButtonUp handler onto directly (tab buttons,
             pin chip, transport controls, the Shelf remove glyph) — none of
             them had any input feedback before this. A Style's own Setter.Value
             for a Transform is a single shared, auto-frozen instance across
             every element that uses the style (a well-known WPF gotcha), which
             would make this animate every element at once instead of just the
             one under the pointer — so unlike PulsingDotStyle above, this only
             defines the *behavior*; every consumer below still declares its
             own literal <RenderTransform><ScaleTransform/></RenderTransform>
             for this style to animate. Release is handled on both
             MouseLeftButtonUp and MouseLeave so a press-and-drag-off doesn't
             strand an element visually stuck at its pressed-down scale. -->
        <Style x:Key="PressableStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="0.96" Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="0.96" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tab content's entrance — a plain property Trigger (not an
             EventTrigger) since Visibility here is a Binding, not something
             this file sets directly: Trigger.EnterActions fires the same way
             whether the bound value just changed or the element is being
             constructed already Visible, so the very first tab shown at
             startup fades in exactly like every later tab switch does,
             with no separate "first time" case to handle. From="0" is
             explicit rather than relying on the current Opacity, so this is
             deterministic regardless of what Opacity happened to be left at. -->
        <Style x:Key="TabContentFadeInStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fade + scale-in for a "notable state" icon appearing (headphone
             connected, pinned) — same Visibility-Trigger idea as
             TabContentFadeInStyle, with a bit more presence (a small scale
             pop, not just a fade) appropriate to a small icon rather than a
             whole panel. Every consumer needs its own literal RenderTransform
             for the same reason PressableStyle's doc comment explains. -->
        <Style x:Key="IconAppearStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.85" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.85" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Same "pop in" as IconAppearStyle above, scale-only — layered onto
             PulsingDotStyle via BasedOn (Style.Triggers from both the base
             and this one apply together) rather than duplicating the
             breathing-fade animation here. Deliberately does NOT also
             animate Opacity: PulsingDotStyle already owns a forever-looping
             Opacity animation from the moment this element loads, and
             starting a second Storyboard on the same property would hand off
             and permanently replace that loop the first time this dot
             appears (BeginStoryboard's default HandoffBehavior snapshots and
             replaces whatever was animating the property) — Scale is a
             separate property, so the two effects run independently instead
             of fighting over one. -->
        <Style x:Key="PulsingDotAppearStyle" TargetType="Ellipse" BasedOn="{StaticResource PulsingDotStyle}">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The collapsed pill's pin chip is the one element that's both
             Visibility-toggled (IconAppearStyle's case) and directly
             clickable (PressableStyle's case) — Style can't inherit from two
             unrelated Styles at once (BasedOn is single-chain), so this is
             the union of both trigger sets written out once rather than
             duplicated as two separately-BasedOn styles. The expanded
             header's pin chip is always visible (no appear needed) and just
             uses PressableStyle directly. -->
        <Style x:Key="PinChipStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.85" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.85" To="1" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseLeftButtonDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="0.9" Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="0.9" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeftButtonUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- One-shot scale pulse on the play/pause button's own accent-filled
             Ellipse whenever playback state flips, in either direction —
             two DataTriggers rather than one, since a DataTrigger's
             EnterActions only fire when *entering* that specific value, and
             a plain bool alternates between exactly those two entries with
             nothing else. Lives on the Ellipse, not the Grid.RenderTransform
             used by PressableStyle on the same button — different elements,
             so the two effects (press-scale on the Grid, state-pulse on the
             Ellipse) run independently without fighting over one property. -->
        <Style x:Key="PlayPausePulseStyle" TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                    <SplineDoubleKeyFrame Value="1.15" KeyTime="0:0:0.08" />
                                    <SplineDoubleKeyFrame Value="1" KeyTime="0:0:0.22" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                    <SplineDoubleKeyFrame Value="1.15" KeyTime="0:0:0.08" />
                                    <SplineDoubleKeyFrame Value="1" KeyTime="0:0:0.22" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                    <SplineDoubleKeyFrame Value="1.15" KeyTime="0:0:0.08" />
                                    <SplineDoubleKeyFrame Value="1" KeyTime="0:0:0.22" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                    <SplineDoubleKeyFrame Value="1.15" KeyTime="0:0:0.08" />
                                    <SplineDoubleKeyFrame Value="1" KeyTime="0:0:0.22" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- List-item entrance/exit for the Shelf's chips. Entrance:
             EventTrigger on Loaded (not a Visibility Trigger) since a
             genuinely new item is a fresh DataTemplate instance the moment
             it's added (ItemsControl generates a new container per item),
             the same reasoning PulsingOpacityStyle's doc comment gives for
             using Loaded on the Shelf's icon placeholder. Exit: a
             DataTrigger on IsRemoving (ShelfItem exposes it) fades +
             shrinks the container — the *view model* is what actually
             removes the item from its collection, timed to this
             animation's own duration (see RemoveShelfItemAsync), so the
             item is visually gone before its container disappears instead
             of popping out instantly. Only Opacity/Scale animate, not
             layout — a true "shrink height and let siblings slide up"
             collapse needs WrapPanel layout itself to animate, which it
             doesn't support, so the remaining chips still snap into place
             the instant the item is actually removed; by then it's already
             faded down to near-nothing, so that snap reads as much smaller
             than it would on an item still at full opacity/size. -->
        <Style x:Key="ListItemEnterStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.22" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0.85" To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0.85" To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <!-- Duration here (0.2s) is matched by ListItemExitDelay in
                     NotchViewModel.cs — kept as two separate constants
                     (XAML can't reference a C# const) rather than one shared
                     value, so a change to either needs to update both. -->
                <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.85" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="0.85" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell"
          Background="Transparent"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          MouseLeftButtonUp="Shell_MouseLeftButtonUp"
          AllowDrop="True"
          DragEnter="Shell_DragEnter"
          DragOver="Shell_DragOver"
          DragLeave="Shell_DragLeave"
          Drop="Shell_Drop">

        <!-- The notch silhouette: a plain rounded-bottom rectangle can't
             show the Dynamic-Island-style flare at the top corners (it
             curves outward past the wall, then back in — a Border's
             single-radius CornerRadius only ever curves one way and never
             outside its own rect), so the shape is a hand-built Path
             instead. Fill and stroke are split into two Paths because the
             stroke deliberately omits the flat top edge (this used to be
             BorderThickness="1,0,1,1" — no top edge) while the fill needs
             the full closed outline. Both Data values are rebuilt in
             code-behind (see BuildShellGeometry) any time Shell resizes,
             including every frame of the expand/collapse animation. -->
        <Path x:Name="ShellFillPath" Fill="{DynamicResource NotchPanelBrush}" IsHitTestVisible="False" />
        <Path x:Name="ShellStrokePath" Stroke="{DynamicResource NotchStrokeBrush}" StrokeThickness="1" IsHitTestVisible="False" />

        <!-- Drag-over invitation for files dropped from Explorer/desktop
             (see the notch design audit, §07's Shelf row) — a dashed accent
             outline that fades in on Shell_DragEnter and out on
             Shell_DragLeave/Shell_Drop (MainWindow.xaml.cs). Reuses
             ShellStrokePath's own outline geometry (same Data, set
             alongside it in UpdateShellGeometry) rather than a separate
             rectangular Border, so the highlight traces the notch's actual
             flared-corner silhouette instead of a generic box. Starts at
             Opacity 0 rather than Collapsed — this animates every drag, so
             it needs to already be in the render tree, not constructed
             fresh each time. -->
        <Path x:Name="ShellDragHighlightPath" Stroke="{DynamicResource NotchAccentBrush}" StrokeThickness="2"
              StrokeDashArray="4 3" IsHitTestVisible="False" Opacity="0" />

        <!-- Clipped to the same geometry as ShellFillPath, kept in sync
             every frame in UpdateShellGeometry — a plain Grid doesn't
             auto-clip its children the way Border used to whenever
             CornerRadius was set, so without this the content renders at
             its full, un-clipped size mid-animation: it visibly outgrows
             the still-catching-up background shape, reading as a stale
             ghost of the old (collapsed or expanded) silhouette left
             behind the new one. -->
        <Grid x:Name="ShellContent">

            <!-- ==================== Collapsed pill ==================== -->
            <StackPanel x:Name="CollapsedPanel"
                        Orientation="Horizontal"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCollapsedIconRowVisible, Converter={StaticResource BoolToVis}}">

                <!-- Identity block: the clock always anchors the left edge, in both
                     the collapsed pill and the expanded header below. The status
                     block that follows keeps the exact same element order in both
                     states too (cam/mic -> headphone -> pin), so expanding reads
                     as one object reshaping instead of elements swapping sides. -->
                <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource NotchTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />

                <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5"
                         Style="{StaticResource PulsingDotAppearStyle}"
                         Fill="{StaticResource NotchCamActiveBrush}"
                         Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}">
                    <Ellipse.RenderTransform>
                        <ScaleTransform />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource NotchWarningBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           Style="{StaticResource IconAppearStyle}"
                           Visibility="{Binding IsMicInUse, Converter={StaticResource BoolToVis}}">
                    <TextBlock.RenderTransform>
                        <ScaleTransform />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            RenderTransformOrigin="0.5,0.5"
                            Style="{StaticResource IconAppearStyle}"
                            Visibility="{Binding IsHeadphoneConnected, Converter={StaticResource BoolToVis}}">
                    <StackPanel.RenderTransform>
                        <ScaleTransform />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource NotchTextPrimaryBrush}"
                               Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource InverseBoolToVis}}" />
                    <Path Data="{StaticResource SurfaceEarbudsGeometry}" Stretch="Uniform" Width="16" Height="16"
                          Fill="{StaticResource NotchTextPrimaryBrush}"
                          Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding HeadphoneBatteryPercent, StringFormat={}{0}%}" FontSize="11" Margin="4,0,0,0"
                               Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center"
                               Visibility="{Binding HasHeadphoneBattery, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Only rendered while pinned — like the cam/mic dots above, this
                     is a "notable state" indicator, not a permanent status readout.
                     Unpinning always happens via the same lock chip in the expanded
                     header; clicking this one (while it's visible) still unpins
                     directly, same as the old pin icon did. -->
                <!-- Same footprint (20x20, radius 4) and icon size (12) as the
                     expanded header's pin chip below — this is the same
                     control in two states, so it shouldn't visibly resize
                     between them. -->
                <Grid Margin="0,0,8,0" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5"
                      Style="{StaticResource PinChipStyle}"
                      MouseLeftButtonUp="PinIcon_MouseLeftButtonUp"
                      Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                    <Grid.RenderTransform>
                        <ScaleTransform />
                    </Grid.RenderTransform>
                    <Border Width="20" Height="20" CornerRadius="4"
                            Background="{StaticResource NotchTabBarBackgroundBrush}" />
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource NotchAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- ==================== Collapsed "now playing" pill ====================
                 Swapped in for CollapsedPanel while media is actively playing: album art
                 pinned to one edge, an animated waveform to the other — same idea as a
                 Dynamic Island reacting to audio. -->
            <Grid x:Name="CollapsedMediaPanel"
                  Margin="16,0,16,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsCollapsedMediaVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                        Background="{StaticResource NotchTileBrush}" ClipToBounds="True">
                    <!-- Border.CornerRadius only rounds the Border's own background, not
                         child content, so the Image needs its own clip geometry too. -->
                    <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                        </Image.Clip>
                    </Image>
                </Border>

                <!-- Bar heights are driven from code-behind (StartWaveformAnimation) rather
                     than a Style trigger here: Storyboard.TargetName can't target a sibling
                     element from inside a plain Style/DataTrigger — only from a
                     ControlTemplate/DataTemplate — so a shared Style.Triggers block can't
                     reach these named Rectangles. -->
                <!-- Fill is bound to WaveformBrush (a color sampled from the
                     thumbnail's dominant hue, see MediaService.ExtractAccentColor)
                     rather than the static NotchTextPrimaryBrush, so the bars
                     draw their color from the album art. -->
                <StackPanel x:Name="WaveformBars" Grid.Column="2" Orientation="Horizontal"
                            Height="16" VerticalAlignment="Center">
                    <Rectangle x:Name="WaveBar1" Width="3" Height="5" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{Binding WaveformBrush}" />
                    <Rectangle x:Name="WaveBar2" Width="3" Height="14" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{Binding WaveformBrush}" />
                    <Rectangle x:Name="WaveBar3" Width="3" Height="9" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{Binding WaveformBrush}" />
                    <Rectangle x:Name="WaveBar4" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{Binding WaveformBrush}" />
                </StackPanel>
            </Grid>

            <!-- ==================== Expanded flyout ==================== -->
            <Grid x:Name="ExpandedPanel"
                  Margin="16"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- One TextBlock with two Runs, not two sibling TextBlocks — WPF
                         lays out same-line Runs of different FontSize on a shared text
                         baseline natively, so this needs no per-pixel nudge to line the
                         date up against the clock (the old Margin="...,3" guess broke
                         the moment either FontSize changed). The gap between them is a
                         same-size spacer Run rather than a Margin, since Run has none. -->
                    <TextBlock VerticalAlignment="Bottom">
                        <Run Text="{Binding TimeText}" FontSize="20" FontWeight="SemiBold"
                             Foreground="{StaticResource NotchTextPrimaryBrush}" />
                        <Run Text="   " FontSize="12" />
                        <Run Text="{Binding DateText}" FontSize="12"
                             Foreground="{StaticResource NotchTextSecondaryBrush}" />
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5"
                                 Style="{StaticResource PulsingDotAppearStyle}"
                                 Fill="{StaticResource NotchCamActiveBrush}"
                                 Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource NotchWarningBrush}"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5"
                                   Style="{StaticResource IconAppearStyle}"
                                   Visibility="{Binding IsMicInUse, Converter={StaticResource BoolToVis}}">
                            <TextBlock.RenderTransform>
                                <ScaleTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                    RenderTransformOrigin="0.5,0.5"
                                    Style="{StaticResource IconAppearStyle}"
                                    Visibility="{Binding IsHeadphoneConnected, Converter={StaticResource BoolToVis}}">
                            <StackPanel.RenderTransform>
                                <ScaleTransform />
                            </StackPanel.RenderTransform>
                            <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}"
                                       Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource InverseBoolToVis}}" />
                            <Path Data="{StaticResource SurfaceEarbudsGeometry}" Stretch="Uniform" Width="16" Height="16"
                                  Fill="{StaticResource NotchTextSecondaryBrush}"
                                  Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding HeadphoneBatteryPercent, StringFormat={}{0}%}" FontSize="11" Margin="4,0,0,0"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding HasHeadphoneBattery, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Settings — expanded header only (no collapsed-pill equivalent,
                             unlike pin/headphone/cam/mic): opens SettingsWindow, a
                             separate native-chrome Mica window rather than another tab,
                             so it lives right next to the pin chip instead of in the tab
                             bar below. Same footprint/style as the pin chip beside it. -->
                        <Grid Margin="0,0,8,0" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              Style="{StaticResource PressableStyle}"
                              MouseLeftButtonUp="SettingsIcon_MouseLeftButtonUp">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border Width="20" Height="20" CornerRadius="4"
                                    Background="{StaticResource NotchTabBarBackgroundBrush}" />
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Settings" />
                        </Grid>

                        <!-- Always visible here (unlike the collapsed one) — this is the
                             one place both pinned and unpinned states, and the actual
                             toggle, live. Only PressableStyle, not the collapsed pill's
                             PinChipStyle — this one is never Visibility-toggled, so it
                             has no "appear" moment to animate. -->
                        <!-- Same footprint (20x20, radius 4) and icon size (12) as the
                             collapsed pill's pin chip — see the note there. -->
                        <Grid Margin="0,0,8,0" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              Style="{StaticResource PressableStyle}"
                              MouseLeftButtonUp="PinIcon_MouseLeftButtonUp">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border Width="20" Height="20" CornerRadius="4"
                                    Background="{StaticResource NotchTabBarBackgroundBrush}" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE785;" />
                                        <Setter Property="Foreground" Value="{StaticResource NotchTextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="&#xE72E;" />
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Tab bar -->
                <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource NotchTabBarBackgroundBrush}" CornerRadius="8" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                              Style="{StaticResource PressableStyle}" MouseLeftButtonUp="MediaTab_MouseLeftButtonUp">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextTertiaryBrush}" ToolTip="Media">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="1" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                              Style="{StaticResource PressableStyle}" MouseLeftButtonUp="VitalsTab_MouseLeftButtonUp">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVitalsTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextTertiaryBrush}" ToolTip="Vitals">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVitalsTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="2" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                              Style="{StaticResource PressableStyle}" MouseLeftButtonUp="NetworkTab_MouseLeftButtonUp">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextTertiaryBrush}" ToolTip="Network">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="3" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                              Style="{StaticResource PressableStyle}" MouseLeftButtonUp="ShelfTab_MouseLeftButtonUp">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextTertiaryBrush}" ToolTip="Shelf">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfTabSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tab content -->
                <Grid Grid.Row="2" Margin="0,14,0,0">

                    <!-- Media tab -->
                    <!-- VerticalAlignment="Center" rather than the Grid row's default
                         top-align: this tab's content (64px thumbnail + a few text
                         lines) is far shorter than the shared content row's height (see
                         NotchHeight's doc comment for why every tab shares one height),
                         so top-aligning it left a large dead gap below; centering
                         balances that leftover space above and below instead. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Style="{StaticResource TabContentFadeInStyle}"
                                Visibility="{Binding IsMediaTabSelected, Converter={StaticResource BoolToVis}}">
                        <!-- x:Name'd so MainWindow.xaml.cs can fade this and MediaTitleText/
                             MediaArtistText together whenever MediaTitle actually changes (a
                             real track change — CommunityToolkit's [ObservableProperty]
                             setters no-op on an unchanged value, so this never fires on the
                             ~1/s timeline-position ticks MediaChanged also carries, only on a
                             genuine new track). Scoped to just these three, not the whole tab:
                             fading the ProgressBar along with them would visibly clash with
                             its own separate value-smoothing animation below. -->
                        <Grid x:Name="MediaThumbnailGrid" Width="64" Height="64" Margin="0,0,12,0">
                            <Border CornerRadius="8" Background="{StaticResource NotchTileBrush}" />
                            <!-- Idle placeholder — reuses the Media tab's own glyph, so an
                                 empty tile reads as "no track loaded" at a glance instead of
                                 as a blank, unfinished-looking square. -->
                            <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}" Opacity="0.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasActiveMediaSession, Converter={StaticResource InverseBoolToVis}}" />
                            <!-- Border.CornerRadius only rounds the Border's own background, not
                                 child content, so the Image needs its own clip geometry too. -->
                            <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding HasActiveMediaSession, Converter={StaticResource BoolToVis}}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8" />
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <StackPanel Width="288" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaTitleText" Text="{Binding MediaTitle}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource NotchTextPrimaryBrush}" />
                            <TextBlock x:Name="MediaArtistText" Text="{Binding MediaArtist}" FontSize="12" Margin="0,2,0,10"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource NotchTextSecondaryBrush}" />

                            <!-- Value is driven entirely from code-behind (AnimateMediaProgress)
                                 rather than the plain Binding this used to be — a live position
                                 tick eases smoothly toward the new value instead of jumping, but
                                 a seek or track change (a large jump) snaps instantly rather than
                                 sweeping across the whole bar; see that method for the threshold. -->
                            <ProgressBar x:Name="MediaProgressBar" Value="0" Minimum="0" Maximum="1"
                                         Height="3" Margin="0,0,0,10"
                                         Foreground="{DynamicResource NotchAccentBrush}"
                                         Background="{StaticResource NotchSliderTrackBrush}" BorderThickness="0" />

                            <!-- Dimmed and click-through while nothing is loaded, so the
                                 transport row reads as idle rather than as active controls
                                 that just happen to do nothing when pressed. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveMediaSession}" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Width="24" Height="24" Background="Transparent" Margin="0,0,16,0"
                                      RenderTransformOrigin="0.5,0.5" Style="{StaticResource PressableStyle}"
                                      MouseLeftButtonUp="Previous_MouseLeftButtonUp">
                                    <Grid.RenderTransform>
                                        <ScaleTransform />
                                    </Grid.RenderTransform>
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>

                                <Grid Width="30" Height="30" Margin="0,0,16,0" Background="Transparent"
                                      RenderTransformOrigin="0.5,0.5" Style="{StaticResource PressableStyle}"
                                      MouseLeftButtonUp="PlayPause_MouseLeftButtonUp">
                                    <Grid.RenderTransform>
                                        <ScaleTransform />
                                    </Grid.RenderTransform>
                                    <Ellipse Fill="{DynamicResource NotchAccentBrush}" RenderTransformOrigin="0.5,0.5"
                                             Style="{StaticResource PlayPausePulseStyle}">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource NotchOnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE768;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                        <Setter Property="Text" Value="&#xE769;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Width="24" Height="24" Background="Transparent"
                                      RenderTransformOrigin="0.5,0.5" Style="{StaticResource PressableStyle}"
                                      MouseLeftButtonUp="Next_MouseLeftButtonUp">
                                    <Grid.RenderTransform>
                                        <ScaleTransform />
                                    </Grid.RenderTransform>
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Vitals tab -->
                    <!-- Rings only now — Download/Upload moved out to their own
                         Network tab (see below) rather than being restyled in
                         place here, so the four rings below get the room that
                         row used to share with them instead of being squeezed
                         above it. -->
                    <!-- Centered for the same reason as the Media tab above — this
                         content is shorter than the shared content row. -->
                    <StackPanel VerticalAlignment="Center"
                                Style="{StaticResource TabContentFadeInStyle}"
                                Visibility="{Binding IsVitalsTabSelected, Converter={StaticResource BoolToVis}}">
                        <!-- Four equal-size live rings (CPU/Memory/Disk/GPU) instead of the
                             stacked bars this used to be — one bar row per metric didn't
                             scale cleanly to a fourth metric, and rings read as "live gauges"
                             at a glance rather than a flat bar. All four share one ring size
                             (VitalsRingRadius/VitalsRingCircumference in the view model) —
                             only each ring's DashOffset differs per metric. 52px (was 44) now
                             that the Download/Upload row above them is gone. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Grid Width="52" Height="52">
                                    <Ellipse Width="52" Height="52" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <!-- StrokeDashOffset is owned entirely by code-behind
                                         (AnimateVitalsRing in MainWindow.xaml.cs) rather than
                                         bound to CpuDashOffset directly — the staggered sweep-
                                         from-empty reveal and the eased live-update retarget
                                         both animate this property via BeginAnimation, and a
                                         live Binding on the same property would fight a running
                                         animation for ownership of it. The view model's
                                         CpuDashOffset is still what the animation reads *as*
                                         its target each time, just not wired through XAML. -->
                                    <Ellipse x:Name="CpuRing" Width="52" Height="52" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding VitalsRingCircumference}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="CPU" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Grid Width="52" Height="52">
                                    <Ellipse Width="52" Height="52" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <!-- See CpuRing's comment above — same reasoning applies to all four rings. -->
                                    <Ellipse x:Name="RamRing" Width="52" Height="52" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding VitalsRingCircumference}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="Memory" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Grid Width="52" Height="52">
                                    <Ellipse Width="52" Height="52" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <!-- See CpuRing's comment above — same reasoning applies to all four rings. -->
                                    <Ellipse x:Name="DiskRing" Width="52" Height="52" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding VitalsRingCircumference}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DiskPercent, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="Disk" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <Grid Width="52" Height="52">
                                    <Ellipse Width="52" Height="52" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="5" />
                                    <!-- See CpuRing's comment above — same reasoning applies to all four rings. -->
                                    <Ellipse x:Name="GpuRing" Width="52" Height="52" StrokeThickness="5"
                                             Stroke="{DynamicResource NotchAccentBrush}"
                                             StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                             StrokeDashArray="{Binding VitalsRingCircumference, Converter={StaticResource DoubleToDashArray}}"
                                             StrokeDashOffset="{Binding VitalsRingCircumference}"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding GpuPercent, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="GPU" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Network tab — speeds only. The identity row (SSID/band/
                         signal, backed by NetworkIdentityService's WlanAPI lookup)
                         was here in the first cut of this tab; removed on request
                         in favor of just the two numbers. Centered for the same
                         reason as the Media tab above — this content is shorter
                         than the shared content row. -->
                    <StackPanel VerticalAlignment="Center"
                                Style="{StaticResource TabContentFadeInStyle}"
                                Visibility="{Binding IsNetworkTabSelected, Converter={StaticResource BoolToVis}}">

                        <!-- Replaces the old inline circular badges (see the notch
                             design audit, §06). Sparkline bars were here in an
                             earlier pass too; removed separately (they were
                             animating every second regardless of whether the tab
                             was even visible, and were suspected of competing with
                             the shell's own resize animation for render budget).
                             Sized up from the original cut (18px icon/26px number,
                             was 12/16) now that this tab has no identity row above
                             it to share the width and height budget with — these
                             tiles are the whole tab's content now, not a secondary
                             row underneath a header. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,6,0" Padding="16,14" CornerRadius="8"
                                    Background="{StaticResource NotchTileBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                        <TextBlock Text="Download" FontSize="12" Margin="6,0,0,0"
                                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding NetworkDownValueText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding NetworkDownUnitText}" FontSize="11" Margin="5,0,0,4" VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="16,14" CornerRadius="8"
                                    Background="{StaticResource NotchTileBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                        <TextBlock Text="Upload" FontSize="12" Margin="6,0,0,0"
                                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding NetworkUpValueText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding NetworkUpUnitText}" FontSize="11" Margin="5,0,0,4" VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Shelf tab -->
                    <Grid Style="{StaticResource TabContentFadeInStyle}"
                          Visibility="{Binding IsShelfTabSelected, Converter={StaticResource BoolToVis}}">
                        <!-- Empty state now leads with a placeholder "+" tile — same
                             72x76/radius-8 footprint as a real chip, so it reads as
                             "this is where chips go" rather than just bare text. Purely
                             decorative — not a button, nothing to click here, just a
                             clearer visual cue than text alone that files land as tiles
                             in this exact spot. The "Drag files onto the notch" caption
                             stays exactly as it was underneath it, unchanged. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsShelfEmpty, Converter={StaticResource BoolToVis}}">
                            <Border Width="72" Height="76" CornerRadius="8" Background="{StaticResource NotchTileBrush}">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" Opacity="0.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Drag files onto the notch" FontSize="12" Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- No explicit MaxHeight: this already sits in the tab content
                             Grid's "*" row, so it naturally stretches to whatever space
                             is actually left after the header/tab bar above it — a fixed
                             MaxHeight guess here could drift out of sync with that and
                             either clip early or overrun it. VerticalScrollBarVisibility
                             keeps handling the case where the shelf has more items than
                             fit. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsShelfEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ShelfItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- ListItemEnterStyle only — no PressableStyle here: this
                                             Border is also a drag source (below), and a press-scale
                                             released on MouseLeftButtonUp/MouseLeave would never fire
                                             mid-drag (the drag consumes the mouse), leaving the chip
                                             visibly stuck at its pressed-down scale after a successful
                                             drag-out. The remove glyph inside is a separate element and
                                             gets PressableStyle on its own. -->
                                        <Border Width="72" Height="76" Margin="0,0,10,10" CornerRadius="8"
                                                Background="{StaticResource NotchTileBrush}"
                                                RenderTransformOrigin="0.5,0.5"
                                                Style="{StaticResource ListItemEnterStyle}"
                                                PreviewMouseLeftButtonDown="ShelfChip_PreviewMouseLeftButtonDown"
                                                MouseMove="ShelfChip_MouseMove">
                                            <Border.RenderTransform>
                                                <ScaleTransform />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Pulsing placeholder glyph while the icon/thumbnail lookup is
                                                         still running (see ShelfItem.IsIconLoading) — swapped for the
                                                         real Image once it resolves, whatever it finds. -->
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                                               Width="28" Height="28" HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Foreground="{StaticResource NotchTextSecondaryBrush}"
                                                               Style="{StaticResource PulsingOpacityStyle}"
                                                               Visibility="{Binding IsIconLoading, Converter={StaticResource BoolToVis}}" />
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center"
                                                           Visibility="{Binding IsIconLoading, Converter={StaticResource InverseBoolToVis}}" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="4,4,4,0" MaxWidth="64"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                                           RenderTransformOrigin="0.5,0.5"
                                                           Style="{StaticResource PressableStyle}"
                                                           Foreground="{StaticResource NotchTextSecondaryBrush}"
                                                           MouseLeftButtonUp="RemoveShelfItem_MouseLeftButtonUp">
                                                    <TextBlock.RenderTransform>
                                                        <ScaleTransform />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
