<Window x:Class="Winland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Winland.Converters"
        Title="Winland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SizeToContent="Manual">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:DoubleToDashArrayConverter x:Key="DoubleToDashArray" />
        <conv:BatteryGlyphConverter x:Key="BatteryGlyph" />

        <!-- Shared by the cam/mic status dots (collapsed + expanded, 4 total) — a
             slow breathing fade rather than a static dot, so an active indicator
             reads as "live" at a glance instead of looking like a painted-on icon.
             Starts on Loaded rather than on Visibility becoming true: these dots
             use Visibility="Collapsed" (not removed from the tree), so Loaded
             fires once at window startup and the animation just runs continuously
             underneath, invisible whenever the dot itself is collapsed. -->
        <Style x:Key="PulsingDotStyle" TargetType="Ellipse">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1.0" To="0.35" Duration="0:0:1.8"
                                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell"
          Background="Transparent"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          MouseLeftButtonUp="Shell_MouseLeftButtonUp"
          AllowDrop="True"
          DragEnter="Shell_DragEnter"
          DragOver="Shell_DragOver"
          Drop="Shell_Drop">

        <!-- The notch silhouette: a plain rounded-bottom rectangle can't
             show the Dynamic-Island-style flare at the top corners (it
             curves outward past the wall, then back in — a Border's
             single-radius CornerRadius only ever curves one way and never
             outside its own rect), so the shape is a hand-built Path
             instead. Fill and stroke are split into two Paths because the
             stroke deliberately omits the flat top edge (this used to be
             BorderThickness="1,0,1,1" — no top edge) while the fill needs
             the full closed outline. Both Data values are rebuilt in
             code-behind (see BuildShellGeometry) any time Shell resizes,
             including every frame of the expand/collapse animation. -->
        <Path x:Name="ShellFillPath" Fill="{DynamicResource NotchPanelBrush}" IsHitTestVisible="False" />
        <Path x:Name="ShellStrokePath" Stroke="{DynamicResource NotchStrokeBrush}" StrokeThickness="1" IsHitTestVisible="False" />

        <!-- Clipped to the same geometry as ShellFillPath, kept in sync
             every frame in UpdateShellGeometry — a plain Grid doesn't
             auto-clip its children the way Border used to whenever
             CornerRadius was set, so without this the content renders at
             its full, un-clipped size mid-animation: it visibly outgrows
             the still-catching-up background shape, reading as a stale
             ghost of the old (collapsed or expanded) silhouette left
             behind the new one. -->
        <Grid x:Name="ShellContent">

            <!-- ==================== Collapsed pill ==================== -->
            <StackPanel x:Name="CollapsedPanel"
                        Orientation="Horizontal"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCollapsedIconRowVisible, Converter={StaticResource BoolToVis}}">

                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                         Style="{StaticResource PulsingDotStyle}"
                         Fill="{StaticResource NotchCamActiveBrush}"
                         Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}" />
                <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                         Style="{StaticResource PulsingDotStyle}"
                         Fill="{StaticResource NotchWarningBrush}"
                         Visibility="{Binding IsMicInUse, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding IsHeadphoneConnected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource NotchTextPrimaryBrush}"
                               Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource InverseBoolToVis}}" />
                    <Path Data="{StaticResource SurfaceEarbudsGeometry}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{StaticResource NotchTextPrimaryBrush}"
                          Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding HeadphoneBatteryPercent, StringFormat={}{0}%}" FontSize="10" Margin="3,0,0,0"
                               Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center"
                               Visibility="{Binding HasHeadphoneBattery, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Text="{Binding BatteryPercent, Converter={StaticResource BatteryGlyph}}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                           Foreground="{StaticResource NotchTextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />

                <TextBlock Text="{Binding TimeText}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource NotchTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <!-- Only rendered while pinned — like the cam/mic dots above, this
                     is a "notable state" indicator, not a permanent status readout.
                     Unpinning always happens via the same lock chip in the expanded
                     header; clicking this one (while it's visible) still unpins
                     directly, same as the old pin icon did. -->
                <Grid Margin="0,0,10,0" VerticalAlignment="Center"
                      MouseLeftButtonUp="PinIcon_MouseLeftButtonUp"
                      Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                    <Border Width="18" Height="16" CornerRadius="6"
                            Background="{StaticResource NotchTabBarBackgroundBrush}" />
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                               Foreground="{DynamicResource NotchAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- ==================== Collapsed "now playing" pill ====================
                 Swapped in for CollapsedPanel while media is actively playing: album art
                 pinned to one edge, an animated waveform to the other — same idea as a
                 Dynamic Island reacting to audio. -->
            <Grid x:Name="CollapsedMediaPanel"
                  Margin="17,0,17,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsCollapsedMediaVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                        Background="{StaticResource NotchTileBrush}" ClipToBounds="True">
                    <!-- Border.CornerRadius only rounds the Border's own background, not
                         child content, so the Image needs its own clip geometry too. -->
                    <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                        </Image.Clip>
                    </Image>
                </Border>

                <!-- Bar heights are driven from code-behind (StartWaveformAnimation) rather
                     than a Style trigger here: Storyboard.TargetName can't target a sibling
                     element from inside a plain Style/DataTrigger — only from a
                     ControlTemplate/DataTemplate — so a shared Style.Triggers block can't
                     reach these named Rectangles. -->
                <StackPanel x:Name="WaveformBars" Grid.Column="2" Orientation="Horizontal"
                            Height="16" VerticalAlignment="Center">
                    <Rectangle x:Name="WaveBar1" Width="3" Height="5" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                    <Rectangle x:Name="WaveBar2" Width="3" Height="14" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                    <Rectangle x:Name="WaveBar3" Width="3" Height="9" Margin="0,0,3,0" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                    <Rectangle x:Name="WaveBar4" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Bottom" Fill="{StaticResource NotchTextPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- ==================== Expanded flyout ==================== -->
            <Grid x:Name="ExpandedPanel"
                  Margin="18,16,18,18"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TimeText}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                        <TextBlock Text="{Binding DateText}" FontSize="12" Margin="8,0,0,3"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Style="{StaticResource PulsingDotStyle}"
                                 Fill="{StaticResource NotchCamActiveBrush}"
                                 Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}" />
                        <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Style="{StaticResource PulsingDotStyle}"
                                 Fill="{StaticResource NotchWarningBrush}"
                                 Visibility="{Binding IsMicInUse, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Visibility="{Binding IsHeadphoneConnected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}"
                                       Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource InverseBoolToVis}}" />
                            <Path Data="{StaticResource SurfaceEarbudsGeometry}" Stretch="Uniform" Width="14" Height="14"
                                  Fill="{StaticResource NotchTextSecondaryBrush}"
                                  Visibility="{Binding IsHeadphoneWireless, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding HeadphoneBatteryPercent, StringFormat={}{0}%}" FontSize="11" Margin="3,0,0,0"
                                       Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding HasHeadphoneBattery, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Always visible here (unlike the collapsed one) — this is the
                             one place both pinned and unpinned states, and the actual
                             toggle, live. -->
                        <Grid Margin="0,0,8,0" VerticalAlignment="Center"
                              MouseLeftButtonUp="PinIcon_MouseLeftButtonUp">
                            <Border Width="22" Height="20" CornerRadius="6"
                                    Background="{StaticResource NotchTabBarBackgroundBrush}" />
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE785;" />
                                        <Setter Property="Foreground" Value="{StaticResource NotchTextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="&#xE72E;" />
                                                <Setter Property="Foreground" Value="{DynamicResource NotchAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{Binding BatteryPercent, Converter={StaticResource BatteryGlyph}}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" FontSize="12"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Tab bar -->
                <Border Grid.Row="1" Margin="0,14,0,0" Background="{StaticResource NotchTabBarBackgroundBrush}" CornerRadius="8" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Background="Transparent" MouseLeftButtonUp="MediaTab_MouseLeftButtonUp">
                            <Border CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="Media">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMediaTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonUp="AiTab_MouseLeftButtonUp">
                            <Border CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAiTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="AI">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAiTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="2" Background="Transparent" MouseLeftButtonUp="VitalsTab_MouseLeftButtonUp">
                            <Border CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVitalsTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="Vitals">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVitalsTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="3" Background="Transparent" MouseLeftButtonUp="ShelfTab_MouseLeftButtonUp">
                            <Border CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfTabSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource NotchTabActiveBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,7"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" ToolTip="Shelf">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShelfTabSelected}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Tab content -->
                <Grid Grid.Row="2" Margin="0,14,0,0">

                    <!-- Media tab -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsMediaTabSelected, Converter={StaticResource BoolToVis}}">
                        <Grid Width="64" Height="64" Margin="0,0,12,0">
                            <Border CornerRadius="8" Background="{StaticResource NotchTileBrush}" />
                            <!-- Border.CornerRadius only rounds the Border's own background, not
                                 child content, so the Image needs its own clip geometry too. -->
                            <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding HasActiveMediaSession, Converter={StaticResource BoolToVis}}">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8" />
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <StackPanel Width="288" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MediaTitle}" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource NotchTextPrimaryBrush}" />
                            <TextBlock Text="{Binding MediaArtist}" FontSize="11.5" Margin="0,2,0,10"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource NotchTextSecondaryBrush}" />

                            <ProgressBar Value="{Binding MediaProgress}" Minimum="0" Maximum="1"
                                         Height="3" Margin="0,0,0,10"
                                         Foreground="{DynamicResource NotchAccentBrush}"
                                         Background="{StaticResource NotchSliderTrackBrush}" BorderThickness="0" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="24" Background="Transparent" Margin="0,0,16,0" MouseLeftButtonUp="Previous_MouseLeftButtonUp">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>

                                <Grid Width="30" Height="30" Margin="0,0,16,0" Background="Transparent" MouseLeftButtonUp="PlayPause_MouseLeftButtonUp">
                                    <Ellipse Fill="{DynamicResource NotchAccentBrush}" />
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource NotchOnAccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE768;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                        <Setter Property="Text" Value="&#xE769;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Width="24" Height="24" Background="Transparent" MouseLeftButtonUp="Next_MouseLeftButtonUp">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- AI tab -->
                    <StackPanel Visibility="{Binding IsAiTabSelected, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Circular, matching the ring/dot vocabulary the rest of
                                 this tab already uses (the usage rings, the pulsing
                                 status dot below) — a rounded-square badge was the one
                                 shape in the tab that didn't belong to that family. -->
                            <Ellipse Grid.Column="0" Width="28" Height="28" Fill="{StaticResource NotchClaudeBrush}" />
                            <TextBlock Grid.Column="0" Text="C" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                            <TextBlock Grid.Column="1" Text="Claude" FontSize="13" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource NotchTextPrimaryBrush}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,5,0"
                                         Fill="{DynamicResource NotchAccentBrush}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClaudeWorking}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseBeginStoryboard">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1" To="0.5" Duration="0:0:1.4"
                                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseBeginStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource NotchTextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Idle" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClaudeWorking}" Value="True">
                                                    <Setter Property="Text" Value="Working…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Grid Width="100" Height="100" Margin="0,0,16,0">
                                <Ellipse Width="80" Height="80" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="7" />
                                <Ellipse Width="54" Height="54" Stroke="{StaticResource NotchSliderTrackBrush}" StrokeThickness="7" />

                                <Ellipse Width="80" Height="80" StrokeThickness="7"
                                         Stroke="{Binding WeeklyRingBrush}"
                                         StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                         StrokeDashArray="{Binding OuterCircumference, Converter={StaticResource DoubleToDashArray}}"
                                         StrokeDashOffset="{Binding OuterDashOffset}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Ellipse Width="54" Height="54" StrokeThickness="7"
                                         Stroke="{Binding FiveHourRingBrush}"
                                         StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                         StrokeDashArray="{Binding InnerCircumference, Converter={StaticResource DoubleToDashArray}}"
                                         StrokeDashOffset="{Binding InnerDashOffset}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WeeklyPercent, StringFormat={}{0}%}" FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                    <TextBlock Text="this week" FontSize="8" HorizontalAlignment="Center"
                                               Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding WeeklyRingBrush}" />
                                        <TextBlock Text="{Binding WeeklyPercent, StringFormat={}Weekly limit – {0}%}" FontSize="11.5"
                                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding WeeklyResetText}" FontSize="10" Margin="14,2,0,0"
                                               Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding FiveHourRingBrush}" />
                                        <TextBlock Text="{Binding FiveHourPercent, StringFormat={}5-hour limit – {0}%}" FontSize="11.5"
                                                   Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FiveHourResetText}" FontSize="10" Margin="14,2,0,0"
                                               Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Vitals tab -->
                    <StackPanel Visibility="{Binding IsVitalsTabSelected, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CPU" FontSize="11.5" Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:0}%}" FontSize="11.5"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="{Binding CpuPercent}" Minimum="0" Maximum="100"
                                         Height="4" Margin="0,5,0,0"
                                         Foreground="{DynamicResource NotchAccentBrush}"
                                         Background="{StaticResource NotchSliderTrackBrush}" BorderThickness="0" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Memory" FontSize="11.5" Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding RamPercent, StringFormat={}{0:0}%}" FontSize="11.5"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="{Binding RamPercent}" Minimum="0" Maximum="100"
                                         Height="4" Margin="0,5,0,0"
                                         Foreground="{DynamicResource NotchAccentBrush}"
                                         Background="{StaticResource NotchSliderTrackBrush}" BorderThickness="0" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Disk" FontSize="11.5" Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DiskPercent, StringFormat={}{0:0}%}" FontSize="11.5"
                                           Foreground="{StaticResource NotchTextSecondaryBrush}" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="{Binding DiskPercent}" Minimum="0" Maximum="100"
                                         Height="4" Margin="0,5,0,0"
                                         Foreground="{DynamicResource NotchAccentBrush}"
                                         Background="{StaticResource NotchSliderTrackBrush}" BorderThickness="0" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Download" FontSize="10" Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                <TextBlock Text="{Binding NetworkDownKBs, StringFormat={}{0:0.0} KB/s}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource NotchTextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Upload" FontSize="10" Foreground="{StaticResource NotchTextSecondaryBrush}" />
                                <TextBlock Text="{Binding NetworkUpKBs, StringFormat={}{0:0.0} KB/s}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource NotchTextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Shelf tab -->
                    <Grid Visibility="{Binding IsShelfTabSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drag files onto the notch" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource NotchTextSecondaryBrush}"
                                   Visibility="{Binding IsShelfEmpty, Converter={StaticResource BoolToVis}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150"
                                      Visibility="{Binding IsShelfEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl ItemsSource="{Binding ShelfItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="72" Height="76" Margin="0,0,10,10" CornerRadius="8"
                                                Background="{StaticResource NotchTileBrush}"
                                                PreviewMouseLeftButtonDown="ShelfChip_PreviewMouseLeftButtonDown"
                                                MouseMove="ShelfChip_MouseMove">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="9.5" Margin="4,4,4,0" MaxWidth="64"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource NotchTextPrimaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                                           Foreground="{StaticResource NotchTextSecondaryBrush}"
                                                           MouseLeftButtonUp="RemoveShelfItem_MouseLeftButtonUp" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
